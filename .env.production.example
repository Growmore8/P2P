# =====================================================================
#  SRM Fintech Solutions — PRODUCTION .env TEMPLATE (MySQL)
#  1) Copy this file to ".env" on the server:   cp .env.production.example .env
#  2) Fill every value marked  <-- CHANGE
#  3) Run:  php artisan key:generate   (fills APP_KEY)
#  NEVER commit the real .env to GitHub.
# =====================================================================

APP_NAME="SRM Fintech Solutions"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com                 # <-- CHANGE (https, no trailing slash)
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ---------- MySQL database (create it in hosting panel first) ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1                              # <-- CHANGE if your host gives a different host
DB_PORT=3306
DB_DATABASE=srm_p2p                            # <-- CHANGE
DB_USERNAME=srm_user                           # <-- CHANGE
DB_PASSWORD=                                   # <-- CHANGE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# ---------- Mail (OTP codes, ticket emails) ----------
MAIL_MAILER=smtp
MAIL_SCHEME=smtps                              # smtps = SSL on 465 · use "smtp" for TLS on 587
MAIL_HOST=smtp.yourmailprovider.com            # <-- CHANGE
MAIL_PORT=465                                  # <-- CHANGE (465 SSL or 587 TLS)
MAIL_USERNAME=info@srmfintechsolutions.com     # <-- CHANGE
MAIL_PASSWORD=                                 # <-- CHANGE
MAIL_FROM_ADDRESS="info@srmfintechsolutions.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- First admin account (created by: php artisan db:seed) ----------
ADMIN_EMAIL=admin@yourdomain.com               # <-- CHANGE (private, real inbox for password reset)
ADMIN_PHONE=+919000000000                      # <-- CHANGE
ADMIN_PASSWORD=                                # <-- CHANGE (strong password, 12+ characters)
